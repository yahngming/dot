#!/bin/sh

setup() {
	if [ -n "$color" ]; then
		matugen --mode $(theme) --source-color-index 0 color hex "$color"
	elif [ -f "$wallpaper" ]; then
		matugen --mode $(theme) --source-color-index 0 image "$wallpaper"
	fi
	if [ "$QT_STYLE_OVERRIDE" == "Windows" ]; then
		exit
	elif [ -n "$WAYLAND_DISPLAY" ]; then
		pgrep awww-daemon || awww-daemon &
		if [ -n "$color" ]; then
			awww clear "$color"
			swaybg -c "$color" &
		elif [ -f "$wallpaper" ]; then
			awww img "$wallpaper"
			cp "$wallpaper" "$paperfolder/wallpaper"
			magick "$paperfolder/wallpaper" -scale 2.5% -resize 4000% "$paperfolder/backdrop"
			swaybg -i "$paperfolder/backdrop" -m fill &
		fi
	elif [ -n "$DISPLAY" ]; then
		if [ -n "$color" ]; then
			magick -size 1x1 xc:"$1" png:- | xwallpaper --zoom -
		elif [ -f "$wallpaper" ]; then
			xwallpaper --zoom "$wallpaper"
		fi
		xdo key_press -k 133; xdo key_press -k 71; sleep 0.2; xdo key_release -k 71; xdo key_release -k 133
		pidof st | xargs kill -s USR1
	fi
}

color() {
	color="$1"
	setup
}

manual() {
	wallpaper="$arg"
	setup
}

picker() {
	wallpaper="$(nsxiv -ot $themefolder/* | shuf -n 1)"
	setup
}

random() {
	wallpaper="$(find $themefolder/* | shuf -n 1)"
	setup
}

weather() {
	wallpaper="$paperfolder/wallpaper"
	magick "$wallpaper" <( curl wttr.in/_tqp0.png ) -geometry +200+200 -composite "$wallpaper"
	setup
}

help() {
	echo "Usage: wallpaper [ARG]"
	echo "  color                     fill with color"
	echo "  directory/filename        set manually"
	echo "  picker                    choose from a picker"
	echo "  random                    random picture"
	echo "  weather                   overlay weather forecast"
	echo "  help                      display help"
}

paperfolder="$HOME/Pictures/wallpapers"
themefolder="$paperfolder/$(theme)"
arg=${1:-help}

case "$arg" in
	color|picker|random|weather|help ) $arg $2 ;;
	*                                ) manual ;;
esac
