#!/bin/sh

load_config() {
	if [ -n "$WAYLAND_DISPLAY" ]; then
		: "${CLIP_COPY:=wl-copy -n}"
		: "${CLIP_PASTE_CLIP:=wl-paste}"
		: "${CLIP_PASTE_PRIM:=wl-paste -p}"
		: "${CLIP_PASTE_IMG:=wl-paste -t image/png}"
		: "${CLIP_TYPE_CLIP:=wl-paste --list-types}"
	else
		: "${CLIP_COPY:=xclip -i -r -selection clipboard}"
		: "${CLIP_PASTE_CLIP:=xclip -o -selection clipboard}"
		: "${CLIP_PASTE_PRIM:=xclip -o -selection primary}"
		: "${CLIP_PASTE_IMG:=xclip -selection clipboard -t image/png -o}"
		: "${CLIP_TYPE_CLIP:=xclip -selection clipboard -target TARGETS -o}"
	fi
	: "${TRANS_ENGINE:=google}"
	: "${TRANS_LANGS:=zh en ja ko}"  # Removed colons from definition to avoid menu parsing errors
	: "${OCR_LANG:=kor+eng+jpn}"     # Tesseract language models
}

formatmenu() {
	printf '%s' "$1" | tr '\n' ' ' | sed 's/\s\{3,\}//g; s/^\(.\{30\}\).\+/\1.../'
}

# Checks if Clipboard contains image data
is_image() {
	eval "$CLIP_TYPE_CLIP" 2>/dev/null | grep -qiE 'image/(png|jpeg|bmp)'
}

# Unified selection retrieval
get_selection() {
	case "$1" in
		img)  eval "$CLIP_PASTE_IMG" 2>/dev/null ;;
		clip) eval "$CLIP_PASTE_CLIP" 2>/dev/null ;;
		*)    eval "$CLIP_PASTE_PRIM" 2>/dev/null ;;
	esac
}

clip_menu() {
	[ -n "$1" ] && printf 'Primary: %s\n' "$(formatmenu "$1")"
	[ -n "$2" ] && printf 'Clipboard: %s\n' "$(formatmenu "$2")"
}

lang_menu() {
	for lang in $TRANS_LANGS; do
		case "$lang" in
			:*) echo "$lang" ;;
			*)  echo ":$lang" ;;
		esac
	done
}

save_file() (
	tmp="$(mktemp --tmpdir 'transmenu.XXXXXX')"
	echo "$1" > "$tmp"
	echo "$tmp"
)

open_term() {
	tui "bat --paging always -pl man '$(save_file "$1")'"
}

get_text() {
	selected="$1"

	case "$selected" in
		Primary:*)
			get_selection prim
			;;
		Clipboard:*)
			if is_image; then
				tmp_img="$(mktemp --tmpdir 'trans_ocr.XXXXXX.png')"
				get_selection img > "$tmp_img"
				tesseract "$tmp_img" stdout -l "$OCR_LANG" 2>/dev/null
				rm -f "$tmp_img"
			else
				get_selection clip
			fi
			;;
		*)
			echo "$selected"
			;;
	esac
}

run_menu() {
	prompt="$1"
	shift
	if command -v menu >/dev/null 2>&1; then
		menu -p "$prompt" "$@"
	elif command -v fuzzel >/dev/null 2>&1; then
		fuzzel --dmenu -p "$prompt "
	elif command -v dmenu >/dev/null 2>&1; then
		dmenu -p "$prompt" "$@"
	elif command -v rofi >/dev/null 2>&1; then
		rofi -dmenu -p "$prompt" "$@"
	else
		cat
	fi
}

load_config

primary="$(get_selection prim)"
is_image && clipboard="[IMAGE CLIPBOARD]" || clipboard="$(get_selection clip)"

clip_menu="$(clip_menu "$primary" "$clipboard")"

# Fallback: if clip_menu is empty, default to reading clipboard directly
if [ -z "$clip_menu" ]; then
	clip_menu="Clipboard: $(formatmenu "$clipboard")"
fi

selection="$(printf '%s\n' "$clip_menu" | run_menu "Translate:" "$@")" || exit 0

text="$(get_text "$selection")"

if [ -n "$text" ]; then
	target="$(lang_menu | run_menu "Into:" "$@")" || exit 0
	if [ -n "$target" ]; then
		open_term "$(trans -e "$TRANS_ENGINE" "$target" "$text")"
	fi
fi
