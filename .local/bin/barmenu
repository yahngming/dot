#!/bin/sh

menu="\
chicago\n\
dwm\n\
float\n\
icononly\n\
macos\n\
mecha\n\
omarchy\n\
powerline\n\
vertical\n\
windows\n\
"

choice=$(printf "$menu" | menu "$@")

if [ -n "$WAYLAND_DISPLAY" ] && [ -f ~/.config/waybar/config-$choice.jsonc ] && [ -f ~/.config/waybar/style-$choice.css ]; then
	cp ~/.config/waybar/config-$choice.jsonc ~/.config/waybar/config.jsonc
 	cp ~/.config/waybar/style-$choice.css ~/.config/waybar/style.css
 	bar
	case "$choice" in
		chicago ) wallpaper color 008080 ;;
		macos   ) wallpaper ~/Pictures/wallpapers/dark/blue.jpg ;;
		windows ) wallpaper ~/Pictures/wallpapers/light/bliss.png ;;
	esac
fi
