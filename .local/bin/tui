#!/bin/sh

case "$@" in
	bc*                                                                             ) class="bottomright" ;;
	bat*|clean|cloud*|dockers*|dot|*fetch*|impala|proxy*|timezone*|*tui*|up|wiremix ) class="center" ;;
	asciiquarium*|lavat*|*matrix*|*svr                                              ) class="screensaver" ;;
	*                                                                               ) class="tui" ;;
esac
title="$(echo "$@" | cut -d ' ' -f 1)"
if [ "$class" = "screensaver" ]; then
	theme="initial-color-theme=light"
fi

case "$TERMINAL" in
	*foot* )$TERMINAL -a "$class" -T "$title" -o $theme -e $SHELL -ic "$@" ;;
	*st*   )$TERMINAL -c "$class" -T "$title" -e $SHELL -ic "$@" ;;
	*xfce* )$TERMINAL --class="$class" --title="$title" --command="$SHELL -ic \"$@\"" ;;
esac
