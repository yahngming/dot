#!/bin/sh

case "$@" in
	bc*                                                                             ) class="bottomright" ;;
	bat*|clean|cloud*|dockers*|dot|*fetch*|impala|proxy*|timezone*|*tui*|up|wiremix ) class="center" ;;
	asciiquarium*|lavat*|*matrix*|*svr                                              ) class="screensaver" ;;
	*                                                                               ) class="tui" ;;
esac
title="$(echo "$@" | cut -d ' ' -f 1)"
command="$SHELL -ic $@"

case "$TERMINAL" in
	*foot*)
		if [ "$class" = "screensaver" ]; then
			theme="-o initial-color-theme=light"
		fi
		class="-a $class"
		title="-T $title"
		command="-e $command"
		;;
	*st*)
		class="-c $class"
		title="-T $title"
		command="-e $command"
		;;
	*xfce*)
		class="--class=$class"
		title="--title=$title"
		command="--command=$command"
		;;
esac

$TERMINAL $theme $class $title $command
