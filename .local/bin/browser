#!/bin/sh

if pgrep -x "$BROWSER" && [ -z "$*" ]; then
	case "$DESKTOP" in
		*dwm*|*xfce*   ) xdo activate -N "$BROWSER" ;;
		*hyprland*     ) hyprctl dispatch focuswindow "$BROWSER" ;;
		*niri*|*mango* ) wlrctl window focus "$BROWSER" ;;
	esac
else
	case "$BROWSER" in
		*chrome*       ) google-chrome-stable --new-tab "$@" ;;
		*fox*|*wolf*   ) $BROWSER --new-tab --profile "$HOME/.config/$BROWSER" "$@" ;;
		*              ) $BROWSER "$@" ;;
	esac
fi
