#!/bin/sh

if pgrep -x "$BROWSER"; then
	case "$DESKTOP" in
		*hyprland*   ) hyprctl dispatch focuswindow "$BROWSER" ;;
		*niri*       ) niri msg action focus-window --id "$(niri msg -j windows | jq -r --arg app "$BROWSER" '.[] | select(.app_id == $app) | .id' | head -n1)" ;;
		*            ) xdotool search --onlyvisible --class "$BROWSER" windowactivate ;;
	esac
else
	case "$BROWSER" in
		*chrome*     ) google-chrome-stable --new-tab "$@" ;;
		*fox*|*wolf* ) $BROWSER --new-tab --profile "$HOME/.config/$BROWSER" "$@" ;;
		*            ) $BROWSER "$@" ;;
	esac
fi
