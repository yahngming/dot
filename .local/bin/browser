#!/bin/sh

if pgrep -x "$BROWSER"; then
	hyprctl dispatch focuswindow "$BROWSER"
	niri msg action focus-window --id "$(niri msg -j windows | jq -r --arg app "$BROWSER" '.[] | select(.app_id == $app) | .id' | head -n1)"
	xdotool search --onlyvisible --class "$BROWSER" windowactivate
    exit
fi

case "$BROWSER" in
	*chrome*     ) google-chrome-stable --new-tab "$@" ;;
	*fox*|*wolf* ) $BROWSER --new-tab --profile "$HOME/.config/$BROWSER" "$@" ;;
	*            ) $BROWSER "$@" ;;
esac
