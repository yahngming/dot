#!/bin/sh

folder="$HOME/Pictures/screenshots"
file="$folder/$(date '+%Y-%m-%d@%H:%M:%S').png"
langs="eng+jpn+kor"
mkdir -p $folder

if [ -n "$WAYLAND_DISPLAY" ]; then
	pkill slurp || grim -g "$(slurp)" -t ppm - | satty --filename - --output-filename "$file" --early-exit --copy-command "wl-copy"
	[ -f "$file" ] && tesseract "$file" stdout -l "$langs" 2>/dev/null | wl-copy -p
elif [ -n "$DISPLAY" ]; then
	pkill maim || maim --hidecursor --select "$file" | xclip -selection clipboard -target image/png
	[ -f "$file" ] && tesseract "$file" stdout -l "$langs" 2>/dev/null | xclip -selection primary
fi
