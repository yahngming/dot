{
	"layer": "top",
	"position": "bottom",
	"reload_style_on_change": true,
	"modules-left": ["custom/start", "ext/workspaces", "wlr/taskbar"],
	"modules-center": [],
	"modules-right": ["temperature#cpu", "temperature#gpu", "tray", "idle_inhibitor", "battery", "network", "wireplumber", "clock"],
	"custom/start": {
		"format": "      Start",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/startmenu.xml",
		"menu-actions": {
			"internetexplorer": "browser",
			"steam": "game",
			"programs": "launcher",
			"documents": "files",
			"settings": "settings",
			"help": "about",
			"run": "terminal",
			"shutdown": "powermenu"
		}
	},
	"ext/workspaces": {
		"on-click": "activate"
	},
	"wlr/taskbar": {
		"format": "{icon} {title:.20}",
		"icon-size": 14,
		"on-click": "minimize-raise",
		"on-click-middle": "close"
	},
	"temperature#cpu": {
		"hwmon-path": ["/sys/class/hwmon/hwmon3/temp1_input"],
		"format": "{temperatureC}",
		"tooltip-format": "CPU {temperatureC}°C"
	},
	"temperature#gpu": {
		"hwmon-path": ["/sys/class/hwmon/hwmon1/temp1_input"],
		"format": "{temperatureC}",
		"tooltip-format": "GPU {temperatureC}°C"
	},
	"tray": {
		"icon-size": 16,
		"spacing": 4
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "󰈈",
			"deactivated": "󰈉"
		},
		"tooltip-format-activated": "Presentation ON",
		"tooltip-format-deactivated": "Presentation OFF",
		"timeout": 240
	},
	"battery": {
		"bat": "BAT0",
		"format": "{icon}",
		"format-charging": "{icon}",
		"format-icons": {
			"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
			"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
		},
		"states": {
			"critical": 10
		}
	},
	"network": {
		"format": "{icon}",
		"format-disconnected": "󰤮",
		"format-ethernet": "󰈀",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"tooltip-format": "󰕒({bandwidthUpBits}) 󰇚({bandwidthDownBits})"
	},
	"wireplumber": {
		"format": "{icon}",
		"format-muted": "󰸈",
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"tooltip-format": "{node_name} {volume}%",
		"on-click": "volume toggle",
		"on-scroll-down": "volume down",
		"on-scroll-up": "volume up"
	},
	"clock": {
		"format": "{:%R}",
		"format-alt": "{:%I:%M %p}",
		"tooltip-format": "<tt><big>{calendar}</big></tt>",
		"calendar": {
			"format": {
				"months": "<b>{}</b>",
				"weekdays": "<b>{}</b>",
				"days": "{}",
				"today": "<span color='tomato'><b>{}</b></span>"
			}
		}
	}
}
